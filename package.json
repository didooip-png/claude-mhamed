{
  "name": "pharmastock",
  "private": true,
  "version": "0.1.0",
  "description": "PharmaStock — gestion de stock de médicaments (API NestJS + SPA React)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @pharmastock/shared build && pnpm --filter @pharmastock/api build && pnpm --filter @pharmastock/web build",
    "dev": "pnpm --filter @pharmastock/shared build && pnpm -r --parallel --filter @pharmastock/shared --filter @pharmastock/api --filter @pharmastock/web run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test:load": "pnpm --filter @pharmastock/api test:load",
    "test:e2e": "pnpm --filter @pharmastock/e2e e2e",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @pharmastock/api run db:migrate",
    "db:seed": "pnpm --filter @pharmastock/api run db:seed",
    "db:reset": "pnpm --filter @pharmastock/api run db:reset",
    "docs:build": "pnpm --filter @pharmastock/shared build && pnpm --filter @pharmastock/docs build --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
