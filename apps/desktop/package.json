{
  "name": "@pharmastock/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PharmaStock \u2014 application Windows (Electron) : impression silencieuse, tiroir-caisse, mises \u00e0 jour",
  "author": "PharmaStock",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "pnpm build && pnpm build:renderer && electron .",
    "dist": "pnpm build && pnpm build:renderer && electron-builder --win --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-to-printer": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
