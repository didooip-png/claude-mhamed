{
  "name": "@pharmastock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --enable-source-maps --import @swc-node/register/esm-register src/main.ts",
    "start": "node --enable-source-maps dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "vitest run -c vitest.load.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node --import @swc-node/register/esm-register prisma/seed.ts",
    "cli": "node --import @swc-node/register/esm-register src/cli.ts",
    "db:make-migration": "node scripts/make-migration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@pharmastock/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "mjml": "^5.4.1",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.12",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/mjml": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "mailparser": "^3.9.31",
    "pino-pretty": "^13.1.3",
    "smtp-server": "^3.19.15",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
